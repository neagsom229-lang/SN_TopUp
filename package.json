{
  "name": "sn-top-up",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/admin",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev:api": "npm --workspace=apps-api run dev",
    "dev:web": "npm --workspace=apps-web run dev",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build:shared": "npm --workspace=@sn-top-up/shared run build",
    "build:api": "npm --workspace=apps-api run build",
    "build:web": "npm --workspace=apps-web run build",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "lint": "npm run lint --workspaces --if-present",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "test": "npm --workspace=apps-api test",
    "test:ci": "npm test && npm run db:verify-rls && npm run db:verify-catalog",
    "db:migrate:deploy": "dotenv -e apps/api/.env -- npx prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:status": "dotenv -e apps/api/.env -- npx prisma migrate status --schema apps/api/prisma/schema.prisma",
    "db:seed": "dotenv -e apps/api/.env -- npm --workspace=apps-api run prisma:seed",
    "db:verify-rls": "dotenv -e apps/api/.env -- npx tsx apps/api/src/verify-rls.ts",
    "db:verify-catalog": "dotenv -e apps/api/.env -- npx tsx apps/api/scripts/verify-catalog.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "concurrently": "^8.2.2",
    "dotenv-cli": "^7.4.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.2.5"
  }
}
